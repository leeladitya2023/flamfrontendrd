{
  "name": "collaborative-canvas",
  "version": "1.0.0",
  "description": "Real-time collaborative drawing canvas with Socket.io",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/main.ts --bundle --outfile=client/dist/main.js --format=esm --platform=browser --target=es2020",
    "build": "npm run build:client",
    "start": "npm run build:client && tsx server/server.ts",
    "dev": "npm run build:client && tsx watch server/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
